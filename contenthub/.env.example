# /opt/contenthub/.env – Vorlage. Kopieren nach .env und Werte setzen.
# Erzeugen von Zufallswerten:  python3 -c 'import secrets;print(secrets.token_hex(32))'

POSTGRES_USER=contenthub
POSTGRES_PASSWORD=BITTE-ERSETZEN

# Verschlüsselt alle in n8n gespeicherten Credentials. Gehört ins Backup!
# Geht er verloren, sind alle Credentials nach einem Restore unbrauchbar.
N8N_ENCRYPTION_KEY=BITTE-ERSETZEN

# Stufe 2 (NocoDB)
NOCODB_JWT_SECRET=BITTE-ERSETZEN

# Alle weiteren Zugänge (LLM-API, SMTP, Telegram-Bot, Meta-Tokens,
# Content-Feed-Tokens der Vereins-Container) werden NICHT hier, sondern
# als Credentials in n8n hinterlegt (verschlüsselt mit N8N_ENCRYPTION_KEY).
