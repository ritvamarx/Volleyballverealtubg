# /etc/cron.d/volleyball-trainingserinnerung – Trainings-Erinnerung am Trainingstag
# Uhrzeit UND an/aus stellt das Trainerteam in der App ein (Trainingsrückmeldung →
# „Automatische Trainings-Erinnerung"). Dieser Cron ist nur der Wecker: er läuft alle
# 15 Min (5–22 Uhr); gesendet wird erst ab der eingestellten Zeit, danach genau einmal
# pro Tag (Merker erinnertTraining am Termin). Einmalig aktivieren:
#   cp /opt/volleyball/deploy/cron/volleyball-trainingserinnerung /etc/cron.d/
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/15 5-22 * * * root cd /opt/volleyball && docker compose exec -T volleyball ./manage.py trainings-erinnern >> /var/log/volleyball-trainingserinnerung.log 2>&1
