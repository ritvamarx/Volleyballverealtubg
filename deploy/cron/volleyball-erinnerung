# /etc/cron.d/volleyball-erinnerung – tägliche Push-Erinnerung an fällige Portal-Aufgaben
# Jede Aufgabe erinnert automatisch nur EINMAL (Merker erinnertAm); manuell nachfassen über 🔔 in der App.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 17 * * * root cd /opt/volleyball && docker compose exec -T volleyball ./manage.py aufgaben-erinnern >> /var/log/volleyball-erinnerung.log 2>&1
